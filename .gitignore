# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Virtual environments and local tooling
.venv/
venv/
.CodeBuddy/

# Editor / OS
.vscode/
.idea/
.DS_Store

# Model artifacts. Trained and promoted models are regenerated, not tracked.
# The two serving artifacts the Docker image copies are re-included below.
*.pkl
*.joblib
*.pt
*.pth
models/pending/
models/approved/
models/latest_approved.json
!models/moe_linear.pkl
!models/online_base.pkl

# Datasets. Full measurement data is never tracked; only the small real-data
# demo subset under datasets/demo/ is committed, via the exception below.
*.parquet
!datasets/demo/**/*.parquet
data/online_logs/
data/training_buffer/
data/controlled_feature_moe_more_runs/

# Generated results. Everything under results/ is regenerated output, except
# results/reference/, which is tracked as the committed reference output.
results/*
!results/reference/

# Runtime state and workflow run artifacts
online_state*
snakemake_integration/.run*/
summary_*.json
plan.json
*.tmp

# Papers, report PDFs and LaTeX build artifacts
papers/
*.pdf
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.out
*.synctex.gz
*.toc

# Windows metadata
*:Zone.Identifier

*:Zone.Identifier
